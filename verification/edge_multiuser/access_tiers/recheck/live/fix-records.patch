+    if missing:
+        return None, missing
+    path = re.sub(r'{(\w+)(?::\w+)?}', lambda m: ids[m.group(1)](route.path) if callable(ids[m.group(1)])
+                  else ids[m.group(1)], route.path)
+    return path, []
