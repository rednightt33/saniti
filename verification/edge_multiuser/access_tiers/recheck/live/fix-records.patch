+def rows_of(store, owner, tables):
+    return {t: sorted(json.dumps(r['row'], sort_keys=True, default=str) for r in db(
+        store, f'SELECT to_jsonb(x) AS row FROM edge_bff.{t} x WHERE owner_key = %s', owner)) for t in tables}
