diff --git a/database/migrations/20261119_020_edge_bff_jobs_site.sql b/database/migrations/20261119_020_edge_bff_jobs_site.sql
new file mode 100644
index 00000000..41bddae5
--- /dev/null
+++ b/database/migrations/20261119_020_edge_bff_jobs_site.sql
@@ -0,0 +1,56 @@
+-- EDGE beta and live websites (EXEC-MU-ACCOUNTS "Production environment", user decisions 2026-11-19: one Railway
+-- environment, two edge-bff services on one database; ERRORS R2-7, R2-13, R2-23, R2-38). The AI job queue
+-- edge_bff.jobs gains `site`: the website a run was queued on, 'beta' (the service edge-bff, its Railway address, the
+-- admin only) or 'live' (edge-bff-live, the user's domain). Each edge-bff claims only the runs of its own site
+-- (app/store.py claim, EDGE_SITE), so a run is dispatched by the code and the rules of the site that took it, never by
+-- the other website's loop. Every row that exists is the beta's (the admin's runs on edge-bff), so the default is
+-- 'beta'; edge-bff writes the column explicitly from now on.
+--
+-- A constant default and a CHECK on the new column: Postgres adds the column without rewriting the table (PG 11+) and
+-- validates the CHECK in one scan. No index: the claim reads the existing partial index edge_bff_claim (created_at,
+-- the active states only), whose rows are a handful at any time; the site filter is applied on them (EXPLAIN in the
+-- fix-round notes, verification/edge_multiuser/fix_round/site.md). No grant changes (a new column of a table
+-- edge_bff_runtime already reads and writes). Forward-only; refuses a second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.jobs') IS NULL THEN
+        RAISE EXCEPTION 'edge_bff.jobs is missing: apply 20261008_002 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'jobs'
+               AND column_name = 'site') THEN
+        RAISE EXCEPTION 'edge_bff.jobs.site exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+ALTER TABLE edge_bff.jobs ADD COLUMN site text NOT NULL DEFAULT 'beta' CONSTRAINT jobs_site CHECK (site IN ('beta', 'live'));
+COMMENT ON COLUMN edge_bff.jobs.site IS 'The website the run was queued on: beta (edge-bff, the admin only) or live (edge-bff-live). Only that site''s worker claims it (EDGE_SITE); rows before 2026-11-19 are the beta''s.';
+
+DO $verify$
+BEGIN
+    IF (SELECT column_default FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'jobs'
+        AND column_name = 'site' AND is_nullable = 'NO') IS DISTINCT FROM '''beta''::text' THEN
+        RAISE EXCEPTION 'edge_bff.jobs.site is not NOT NULL DEFAULT beta';
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = 'edge_bff.jobs'::regclass AND conname = 'jobs_site'
+                   AND convalidated) THEN
+        RAISE EXCEPTION 'the check jobs_site is missing or not validated';
+    END IF;
+    IF EXISTS (SELECT 1 FROM edge_bff.jobs WHERE site <> 'beta') THEN
+        RAISE EXCEPTION 'a run that existed before this migration is not the beta''s';
+    END IF;
+    IF NOT (has_table_privilege('edge_bff_runtime', 'edge_bff.jobs', 'SELECT')
+            AND has_table_privilege('edge_bff_runtime', 'edge_bff.jobs', 'INSERT')
+            AND has_table_privilege('edge_bff_runtime', 'edge_bff.jobs', 'UPDATE')) THEN
+        RAISE EXCEPTION 'edge_bff_runtime lost a grant on edge_bff.jobs';
+    END IF;
+END $verify$;
+COMMIT;
+
+-- Rollback (a new forward migration with this body, after every edge-bff runs a build that does not read the column:
+-- edge-bff's readiness reads edge_bff.jobs.site, app/store.py ready):
+-- BEGIN;
+-- ALTER TABLE edge_bff.jobs DROP COLUMN site;
+-- COMMIT;
diff --git a/database/migrations/20261119_021_edge_bff_backtest_jobs_site.sql b/database/migrations/20261119_021_edge_bff_backtest_jobs_site.sql
new file mode 100644
index 00000000..63af2288
--- /dev/null
+++ b/database/migrations/20261119_021_edge_bff_backtest_jobs_site.sql
@@ -0,0 +1,61 @@
+-- EDGE beta and live websites (EXEC-MU-ACCOUNTS "Production environment", user decisions 2026-11-19: one Railway
+-- environment, two edge-bff services on one database; ERRORS R2-7, R2-13, R2-23, R2-38). The backtest queue
+-- edge_bff.backtest_jobs gains `site`: the website a backtest was queued on, 'beta' (the service edge-bff, the admin
+-- only) or 'live' (edge-bff-live, the user's domain). Both websites run a backtest loop; each claims, reaps and prunes
+-- only its own site's jobs (app/backtest.py BacktestStore, EDGE_SITE), so a paid account's backtest queued on the live
+-- site is dispatched under the live site's principal and release file, never by the beta's loop (the probe of R2-7:
+-- a switch-off loop ended a switch-on account's job FAILED CAPABILITY_REQUIRED). One running job per owner stays one
+-- rule over both sites (backtest_jobs_one_running_owner). Every row that exists is the beta's (the admin's backtests on
+-- edge-bff), so the default is 'beta'; edge-bff writes the column explicitly from now on.
+--
+-- A constant default and a CHECK on the new column: added without a table rewrite (PG 11+), the CHECK validated in one
+-- scan. No index: the claim reads the existing partial index backtest_jobs_claim (created_at, QUEUED and RUNNING
+-- only), whose rows are a handful; the site filter is applied on them (EXPLAIN in the fix-round notes,
+-- verification/edge_multiuser/fix_round/site.md). No grant changes. Separate from 20261119_020 so that a test which
+-- takes 20261026_005 out and puts it back can put this column back too. Forward-only; refuses a second run; rollback
+-- block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.backtest_jobs') IS NULL THEN
+        RAISE EXCEPTION 'edge_bff.backtest_jobs is missing: apply 20261026_005 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'backtest_jobs'
+               AND column_name = 'site') THEN
+        RAISE EXCEPTION 'edge_bff.backtest_jobs.site exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+ALTER TABLE edge_bff.backtest_jobs ADD COLUMN site text NOT NULL DEFAULT 'beta'
+    CONSTRAINT backtest_jobs_site CHECK (site IN ('beta', 'live'));
+COMMENT ON COLUMN edge_bff.backtest_jobs.site IS 'The website the backtest was queued on: beta (edge-bff, the admin only) or live (edge-bff-live). Only that site''s loop claims, reaps and prunes it (EDGE_SITE); rows before 2026-11-19 are the beta''s.';
+
+DO $verify$
+BEGIN
+    IF (SELECT column_default FROM information_schema.columns WHERE table_schema = 'edge_bff'
+        AND table_name = 'backtest_jobs' AND column_name = 'site' AND is_nullable = 'NO') IS DISTINCT FROM '''beta''::text' THEN
+        RAISE EXCEPTION 'edge_bff.backtest_jobs.site is not NOT NULL DEFAULT beta';
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = 'edge_bff.backtest_jobs'::regclass
+                   AND conname = 'backtest_jobs_site' AND convalidated) THEN
+        RAISE EXCEPTION 'the check backtest_jobs_site is missing or not validated';
+    END IF;
+    IF EXISTS (SELECT 1 FROM edge_bff.backtest_jobs WHERE site <> 'beta') THEN
+        RAISE EXCEPTION 'a backtest that existed before this migration is not the beta''s';
+    END IF;
+    -- what app/backtest.py does to the jobs and no more (20261026_005): jobs are never deleted
+    IF NOT (has_table_privilege('edge_bff_runtime', 'edge_bff.backtest_jobs', 'SELECT')
+            AND has_table_privilege('edge_bff_runtime', 'edge_bff.backtest_jobs', 'INSERT')
+            AND has_table_privilege('edge_bff_runtime', 'edge_bff.backtest_jobs', 'UPDATE'))
+       OR has_table_privilege('edge_bff_runtime', 'edge_bff.backtest_jobs', 'DELETE') THEN
+        RAISE EXCEPTION 'edge_bff_runtime does not hold exactly SELECT, INSERT and UPDATE on edge_bff.backtest_jobs';
+    END IF;
+END $verify$;
+COMMIT;
+
+-- Rollback (a new forward migration with this body, after every edge-bff runs a build that does not read the column):
+-- BEGIN;
+-- ALTER TABLE edge_bff.backtest_jobs DROP COLUMN site;
+-- COMMIT;
diff --git a/database/migrations/20261119_022_edge_bff_seed_verifier_mark.sql b/database/migrations/20261119_022_edge_bff_seed_verifier_mark.sql
new file mode 100644
index 00000000..509adc30
--- /dev/null
+++ b/database/migrations/20261119_022_edge_bff_seed_verifier_mark.sql
@@ -0,0 +1,62 @@
+-- EDGE beta and live websites (EXEC-MU-ACCOUNTS "Production environment", user decisions 2026-11-19; ERRORS R2-2,
+-- R2-13, R2-38): the seed of user #1 copies EDGE_PASSWORD_VERIFIER onto user #1's password identity at every start with
+-- EDGE_MULTIUSER off (app/accounts.py AccountStore.seed), so that sign-in works the same the moment the switch goes on.
+-- With the beta (switch off) and the live site (switch on) on one database, every beta deploy undid a password the admin
+-- changed or reset on the live site, and the replaced password signed in again.
+--
+-- edge_bff.identities gains seed_verifier_sha256: the SHA-256 (hex) of the verifier the seed last wrote, never the
+-- verifier itself. The seed copies the environment's verifier only while the identity still holds that copy
+-- (sha256(verifier) = seed_verifier_sha256); a change or a reset (app/auth_flows.py) writes a new verifier, so the
+-- identity is the account's own from then on and no start overwrites it. The switch-off sign-in still reads
+-- EDGE_PASSWORD_VERIFIER itself (app/main.py), as before.
+--
+-- Filled here for the seed's own identity: the switch has never been on outside the test suites (EXEC.md, EDGE_MULTIUSER
+-- off on dev), so the verifier user #1 holds today is the one the seed copied. Every other identity keeps NULL (the seed
+-- never wrote it). No grant changes (a new column of a table edge_bff_runtime already reads and writes). Forward-only;
+-- refuses a second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.identities') IS NULL OR to_regclass('edge_bff.users') IS NULL THEN
+        RAISE EXCEPTION 'the EDGE account tables are missing: apply 20261116_003 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'identities'
+               AND column_name = 'seed_verifier_sha256') THEN
+        RAISE EXCEPTION 'edge_bff.identities.seed_verifier_sha256 exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+ALTER TABLE edge_bff.identities ADD COLUMN seed_verifier_sha256 text
+    CONSTRAINT identities_seed_verifier_sha256 CHECK (seed_verifier_sha256 ~ '^[0-9a-f]{64}$');
+COMMENT ON COLUMN edge_bff.identities.seed_verifier_sha256 IS 'SHA-256 (hex) of the verifier the seed of user #1 last copied from EDGE_PASSWORD_VERIFIER; the seed copies again only while sha256(verifier) equals it (a password the account set itself is never overwritten). NULL: the seed never wrote this identity.';
+
+-- the seed's identity: user #1 is the one account whose owner key is not of the 'u_' form (users_one_seed)
+UPDATE edge_bff.identities i SET seed_verifier_sha256 = encode(sha256(convert_to(i.verifier, 'UTF8')), 'hex')
+FROM edge_bff.users u
+WHERE u.user_id = i.user_id AND i.provider = 'password' AND u.owner_key !~ '^u_[0-9a-f]{24}$';
+
+DO $verify$
+BEGIN
+    IF EXISTS (SELECT 1 FROM edge_bff.identities i JOIN edge_bff.users u ON u.user_id = i.user_id
+               WHERE i.provider = 'password' AND u.owner_key !~ '^u_[0-9a-f]{24}$'
+                 AND i.seed_verifier_sha256 IS DISTINCT FROM encode(sha256(convert_to(i.verifier, 'UTF8')), 'hex')) THEN
+        RAISE EXCEPTION 'the seed''s password identity does not carry the mark of its verifier';
+    END IF;
+    IF EXISTS (SELECT 1 FROM edge_bff.identities i JOIN edge_bff.users u ON u.user_id = i.user_id
+               WHERE u.owner_key ~ '^u_[0-9a-f]{24}$' AND i.seed_verifier_sha256 IS NOT NULL) THEN
+        RAISE EXCEPTION 'an account other than the seed carries a seed mark';
+    END IF;
+    IF NOT (has_table_privilege('edge_bff_runtime', 'edge_bff.identities', 'SELECT')
+            AND has_table_privilege('edge_bff_runtime', 'edge_bff.identities', 'UPDATE')) THEN
+        RAISE EXCEPTION 'edge_bff_runtime lost a grant on edge_bff.identities';
+    END IF;
+END $verify$;
+COMMIT;
+
+-- Rollback (a new forward migration with this body, after every edge-bff runs a build that does not read the column;
+-- the seed then copies the environment's verifier at every switch-off start again):
+-- BEGIN;
+-- ALTER TABLE edge_bff.identities DROP COLUMN seed_verifier_sha256;
+-- COMMIT;
diff --git a/database/migrations/20261119_023_edge_bff_account_reference_indexes.sql b/database/migrations/20261119_023_edge_bff_account_reference_indexes.sql
new file mode 100644
index 00000000..4ac242f5
--- /dev/null
+++ b/database/migrations/20261119_023_edge_bff_account_reference_indexes.sql
@@ -0,0 +1,70 @@
+-- EDGE accounts (EXEC-MU-ACCOUNTS; ERRORS R2-34, R2-33): an index on every column that references edge_bff.users.
+-- 20261116_003 and 20261117_003 added these foreign keys with no index on the referencing column ("indexes beyond the
+-- keys: none", CONTRACT.md section 1, on the assumption that users and sessions number in the thousands). But Postgres
+-- checks each referencing table once per deleted account (ON DELETE CASCADE / SET NULL), so without an index every
+-- deleted account scans sessions, email_codes, admin_audit (twice), subscriptions and user_capability_overrides in full:
+-- the hourly purge of registrations never verified (app/accounts.py purge_pending) took 5.0 s for 200 accounts with 100k
+-- sessions and 107k codes (the store's statement_timeout), and its cost grew with the square of the pending backlog. The
+-- same columns serve the principal's reads by account: the sign-in's session cap and revoke_all (sessions.user_id), the
+-- resolve's live and lapsed subscriptions (subscriptions.user_id; the partial subscriptions_one_active serves neither the
+-- cascade nor the lapsed read, nor does the partial email_codes_one_live serve the cascade).
+--
+-- Plain btree indexes, measured with bounded EXPLAIN (ANALYZE, BUFFERS) before and after (the fix-round notes,
+-- verification/edge_multiuser/fix_round/site.md). The tables are small today (the switch is off on dev: one account),
+-- so CREATE INDEX in the migration's transaction holds each table's write lock for milliseconds. No grant changes.
+-- Rule from here on (CONTRACT.md section 1, recorded with this fix): every foreign key to edge_bff.users has an index
+-- whose leading column is the referencing column (tests/test_c2_ops_recheck.py test_every_reference_to_an_account_has_an_index).
+-- Forward-only; refuses a second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '5min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.users') IS NULL OR to_regclass('edge_bff.subscriptions') IS NULL
+       OR to_regclass('edge_bff.user_capability_overrides') IS NULL THEN
+        RAISE EXCEPTION 'the EDGE account tables or the plan catalog are missing: apply 20261116_003 and 20261117_003 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = 'edge_bff'
+               AND c.relname IN ('sessions_user_id', 'email_codes_user_id', 'admin_audit_actor_user_id',
+                                 'admin_audit_target_user_id', 'subscriptions_user_id_starts',
+                                 'user_capability_overrides_created_by')) THEN
+        RAISE EXCEPTION 'an index of this migration exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+CREATE INDEX sessions_user_id ON edge_bff.sessions(user_id);
+CREATE INDEX email_codes_user_id ON edge_bff.email_codes(user_id);
+CREATE INDEX admin_audit_actor_user_id ON edge_bff.admin_audit(actor_user_id);
+CREATE INDEX admin_audit_target_user_id ON edge_bff.admin_audit(target_user_id);
