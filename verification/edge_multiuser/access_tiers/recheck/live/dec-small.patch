+       OR has_function_privilege('public', 'edge_bff.purge_email_outbox()', 'EXECUTE') THEN
+        RAISE EXCEPTION 'edge_bff.purge_email_outbox() is not for edge_bff_runtime only';
+    END IF;
+    IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE oid = 'edge_bff.purge_email_outbox()'::regprocedure AND prosecdef
