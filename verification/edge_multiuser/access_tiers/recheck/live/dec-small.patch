+def age_mfa_pass(store, seconds):
+    db(store, 'UPDATE edge_bff.sessions SET mfa_passed_at = mfa_passed_at - make_interval(secs => %s) '
+              'WHERE mfa_passed_at IS NOT NULL AND revoked_at IS NULL', seconds)
