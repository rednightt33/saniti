+        name, problem = person_name(bad)
+        assert problem and ' ' in problem, bad
+    assert [export_cell(v) for v in ('=1+1', '+62', '-x', '@a', 'Ana')] == ["'=1+1", "'+62", "'-x", "'@a", 'Ana']
+
+
+def test_registration_refuses_a_name_with_a_bidi_override(settings, store):
