diff --git a/database/migrations/20261119_010_edge_bff_password_identity.sql b/database/migrations/20261119_010_edge_bff_password_identity.sql
new file mode 100644
index 00000000..b46bae47
--- /dev/null
+++ b/database/migrations/20261119_010_edge_bff_password_identity.sql
@@ -0,0 +1,70 @@
+-- EDGE multi-user, fix round of the ultracode re-check (EXEC-MU-ACCOUNTS; verification/edge_multiuser/fix_round/auth.md;
+-- contract verification/edge_multiuser/access_tiers/CONTRACT.md section 4). The password identity of an account
+-- (edge_bff.identities, 20261116_003), behind the switch EDGE_MULTIUSER (off until Phase 6: with it off edge-bff only
+-- copies EDGE_PASSWORD_VERIFIER into user #1's identity and reads none of the new columns). Two changes:
+-- 1. ERRORS R2-29 (OWASP Password Storage Cheat Sheet: scrypt N=2^17, r=8, p=1, or an equivalent such as N=2^14, r=8,
+--    p=5): a verifier may name its cost, 'scrypt$n=16384,r=8,p=5$<salt hex 32>$<hash hex 64>' (app/security.py, every
+--    new verifier). The form before it, 'scrypt$<salt>$<hash>' (N=2^14, r=8, p=1), stays valid: edge-bff reads both and
+--    replaces the old one at the account's next sign-in (accounts.py create_session `rehash`). The CHECK
+--    identities_password is replaced by one that accepts both; edge-bff accepts only the costs it lists (security.py
+--    COSTS), the CHECK only the shape.
+-- 2. ERRORS R1-16 (NIST SP 800-63B-4 3.2.2: at most 100 consecutive failed attempts per subscriber account): the
+--    consecutive failed passwords of the account over both its logins (username and email) and every client address
+--    (sign_in_failures), and the end of the lock the 100th starts (sign_in_locked_until, 24 h). A success, a password
+--    reset proved by the email code or a change sets them back to 0 and NULL (ERRORS R1-9: the way back); after a lock
+--    the count restarts at 90 (as the MFA counts of 20261117_002, decision N2 of ERRORS M478).
+-- No grant changes (edge_bff_runtime already holds SELECT, INSERT, UPDATE, DELETE on identities). No index: every read
+-- and write of these columns is by the primary key's user_id (UNIQUE (user_id, provider)). Forward-only; refuses a
+-- second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.identities') IS NULL OR NOT EXISTS (SELECT 1 FROM pg_constraint
+            WHERE conrelid = 'edge_bff.identities'::regclass AND conname = 'identities_password') THEN
+        RAISE EXCEPTION 'edge_bff.identities or its identities_password check is missing: apply 20261116_003 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'identities'
+               AND column_name IN ('sign_in_failures', 'sign_in_locked_until')) THEN
+        RAISE EXCEPTION 'a column of this migration exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+ALTER TABLE edge_bff.identities
+    DROP CONSTRAINT identities_password,
+    -- a password identity: its subject is the user_id and its verifier one of the two scrypt forms of app/security.py
+    ADD CONSTRAINT identities_password CHECK (provider <> 'password' OR (subject = user_id::text
+        AND verifier ~ '^scrypt\$(n=[0-9]{1,7},r=[0-9]{1,2},p=[0-9]{1,2}\$)?[0-9a-f]{32}\$[0-9a-f]{64}$')),
+    ADD COLUMN sign_in_failures integer NOT NULL DEFAULT 0 CHECK (sign_in_failures >= 0),
+    ADD COLUMN sign_in_locked_until timestamptz;
+COMMENT ON COLUMN edge_bff.identities.verifier IS 'Password: scrypt$n=<N>,r=<r>,p=<p>$<salt hex>$<hash hex> (app/security.py COST, N=2^14 r=8 p=5), or the form before 20261119_010, scrypt$<salt>$<hash> (N=2^14 r=8 p=1), replaced at the next sign-in.';
+COMMENT ON COLUMN edge_bff.identities.sign_in_failures IS 'Consecutive failed passwords of the account (both logins, every client address), counted before each check; at 100 sign-in is locked 24 h (answered as a wrong password); a success, a reset by email code or a change sets 0 (NIST SP 800-63B-4).';
+COMMENT ON COLUMN edge_bff.identities.sign_in_locked_until IS 'When the password lock the 100th consecutive failure started ends; NULL = no lock. After it the count restarts at 90.';
+
+DO $verify$
+BEGIN
+    IF EXISTS (SELECT 1 FROM edge_bff.identities WHERE provider = 'password' AND sign_in_failures <> 0) THEN
+        RAISE EXCEPTION 'an identity starts with failures';
+    END IF;
+    -- the existing verifiers (the form before this migration) still satisfy the new check: it was re-validated by the
+    -- ADD CONSTRAINT above; both forms are accepted, nothing else is
+    IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = 'edge_bff.identities'::regclass
+                   AND conname = 'identities_password' AND convalidated) THEN
+        RAISE EXCEPTION 'identities_password is missing or not validated';
+    END IF;
+    IF NOT has_table_privilege('edge_bff_runtime', 'edge_bff.identities', 'UPDATE')
+       OR has_table_privilege('public', 'edge_bff.identities', 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE') THEN
+        RAISE EXCEPTION 'the grants of edge_bff.identities differ from 20261116_003';
+    END IF;
+END $verify$;
+COMMIT;
+
+-- Rollback (a new forward migration with this body; deploy an edge-bff that writes only the old form first, and replace
+-- every verifier of the new form first, or those accounts cannot sign in: the old form cannot hold their cost):
+-- BEGIN;
+-- ALTER TABLE edge_bff.identities DROP COLUMN sign_in_failures, DROP COLUMN sign_in_locked_until,
+--     DROP CONSTRAINT identities_password,
+--     ADD CONSTRAINT identities_password CHECK (provider <> 'password' OR (subject = user_id::text
+--         AND verifier ~ '^scrypt\$[0-9a-f]{32}\$[0-9a-f]{64}$'));
+-- COMMIT;
diff --git a/database/migrations/20261119_011_edge_bff_mfa_pending_enrolment.sql b/database/migrations/20261119_011_edge_bff_mfa_pending_enrolment.sql
new file mode 100644
index 00000000..1b78035c
--- /dev/null
+++ b/database/migrations/20261119_011_edge_bff_mfa_pending_enrolment.sql
@@ -0,0 +1,68 @@
+-- EDGE multi-user, fix round of the ultracode re-check (EXEC-MU-ACCOUNTS; verification/edge_multiuser/fix_round/auth.md;
+-- contract verification/edge_multiuser/access_tiers/CONTRACT.md section 4 "Admin MFA"), behind the switch EDGE_MULTIUSER
+-- (off until Phase 6; with it off nothing reads these tables).
+-- ERRORS R1-7: a new enrolment of an admin's authenticator overwrote the one mfa_totp row at once (confirmed_at NULL,
+-- the recovery codes deleted), so from the moment an admin who had passed MFA began setting up a new phone, the account
+-- had no confirmed second factor: a password-only session could enrol its own authenticator and take the admin's.
+-- Now a confirmed enrolment and a new one wait side by side:
+--   mfa_totp.pending_nonce / pending_created_at  the new enrolment's nonce (its TOTP secret is HMAC(EDGE_MFA_KEY,
+--                                                user_id || nonce), never stored) while it is not confirmed;
+--   mfa_recovery_codes.pending                   the new enrolment's recovery codes, never accepted until it is.
+-- The first code of the new authenticator (app/auth_flows.py use_step) moves pending_nonce to nonce and makes its
+-- recovery codes the account's; until then the confirmed authenticator, its replay guard (last_step) and its recovery
+-- codes keep working. A first enrolment (no confirmed one yet) still uses nonce with confirmed_at NULL.
+-- No grant changes (edge_bff_runtime already holds SELECT, INSERT, UPDATE, DELETE on both tables). No index: every read
+-- and write is by user_id (mfa_totp's primary key; mfa_recovery_codes' primary key (user_id, code_hash)).
+-- Forward-only; refuses a second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff' AND table_name = 'mfa_totp'
+                   AND column_name = 'totp_failures') THEN
+        RAISE EXCEPTION 'edge_bff.mfa_totp.totp_failures is missing: apply 20261117_002 first';
+    END IF;
+    IF EXISTS (SELECT 1 FROM information_schema.columns WHERE table_schema = 'edge_bff'
+               AND ((table_name = 'mfa_totp' AND column_name IN ('pending_nonce', 'pending_created_at'))
+                    OR (table_name = 'mfa_recovery_codes' AND column_name = 'pending'))) THEN
+        RAISE EXCEPTION 'a column of this migration exists: reconcile before applying';
+    END IF;
+END $preflight$;
+
+ALTER TABLE edge_bff.mfa_totp
+    ADD COLUMN pending_nonce bytea CHECK (octet_length(pending_nonce) = 16),
+    ADD COLUMN pending_created_at timestamptz,
+    -- a new enrolment waits only beside a confirmed one, and never names the confirmed nonce
+    ADD CONSTRAINT mfa_totp_pending CHECK ((pending_nonce IS NULL) = (pending_created_at IS NULL)
+        AND (pending_nonce IS NULL OR (confirmed_at IS NOT NULL AND pending_nonce <> nonce)));
+COMMENT ON COLUMN edge_bff.mfa_totp.pending_nonce IS 'A new enrolment begun by a session that passed MFA, waiting for its first code; the confirmed nonce keeps working until then (use_step makes it the nonce).';
+COMMENT ON COLUMN edge_bff.mfa_totp.pending_created_at IS 'When the waiting enrolment (pending_nonce) was begun.';
+
+ALTER TABLE edge_bff.mfa_recovery_codes
+    ADD COLUMN pending boolean NOT NULL DEFAULT false;
+COMMENT ON COLUMN edge_bff.mfa_recovery_codes.pending IS 'A code of the waiting enrolment (mfa_totp.pending_nonce): never accepted; becomes the account''s (false) when that enrolment is confirmed, and the old codes are deleted then.';
+
+DO $verify$
+BEGIN
+    IF EXISTS (SELECT 1 FROM edge_bff.mfa_totp WHERE pending_nonce IS NOT NULL)
+       OR EXISTS (SELECT 1 FROM edge_bff.mfa_recovery_codes WHERE pending) THEN
+        RAISE EXCEPTION 'an enrolment starts as waiting';
+    END IF;
+    IF NOT has_table_privilege('edge_bff_runtime', 'edge_bff.mfa_totp', 'UPDATE')
+       OR NOT has_table_privilege('edge_bff_runtime', 'edge_bff.mfa_recovery_codes', 'UPDATE')
+       OR has_table_privilege('public', 'edge_bff.mfa_totp', 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE')
+       OR has_table_privilege('public', 'edge_bff.mfa_recovery_codes', 'SELECT, INSERT, UPDATE, DELETE, TRUNCATE') THEN
+        RAISE EXCEPTION 'the grants of the MFA tables differ from 20261116_003';
+    END IF;
+END $verify$;
+COMMIT;
+
+-- Rollback (a new forward migration with this body; deploy the previous edge-bff first; a waiting enrolment is lost,
+-- its admin begins it again):
+-- BEGIN;
+-- DELETE FROM edge_bff.mfa_recovery_codes WHERE pending;
+-- ALTER TABLE edge_bff.mfa_recovery_codes DROP COLUMN pending;
+-- ALTER TABLE edge_bff.mfa_totp DROP CONSTRAINT mfa_totp_pending, DROP COLUMN pending_nonce,
+--     DROP COLUMN pending_created_at;
+-- COMMIT;
diff --git a/database/migrations/20261119_012_edge_bff_email_outbox_purge.sql b/database/migrations/20261119_012_edge_bff_email_outbox_purge.sql
new file mode 100644
index 00000000..2160222c
--- /dev/null
+++ b/database/migrations/20261119_012_edge_bff_email_outbox_purge.sql
@@ -0,0 +1,80 @@
+-- EDGE multi-user, fix round of the ultracode re-check (EXEC-MU-ACCOUNTS; verification/edge_multiuser/fix_round/auth.md;
+-- contract verification/edge_multiuser/access_tiers/CONTRACT.md sections 1, 4 and 5), behind the switch EDGE_MULTIUSER
+-- (off until Phase 6; with it off nothing is written to the outbox, so both reads and the purge find no row).
+-- 1. ERRORS R2-35: the hot reads of edge_bff.email_outbox scanned every email ever sent: the 60-second gap between code
+--    emails of an address (app/auth_flows.py _may_send, on every register, resend, forgot and sign-in restart, by
+--    to_email and created_at) and the sender's claim every 5 s (app/mailer.py OutboxStore.claim: the expired and
+--    suppressed UPDATEs and the SELECT ... FOR UPDATE SKIP LOCKED, all on rows still pending or sending). Two indexes:
+--      email_outbox_to_email_created  (to_email, created_at)          _may_send; the purge by address
+--      email_outbox_unsent            (next_at) WHERE pending/sending  the claim (a handful of rows, whatever the size)
+--    Measured (EXPLAIN, 20 000 sent rows, tests/test_c2_ops_recheck.py): without them all four statements are Seq Scans;
+--    with them none is (the finder's control and this migration's run, fix_round/auth.md).
+-- 2. ERRORS R2-24: the hourly purge deleted a registration never verified 24 h after it was made (CONTRACT 4), but every
+--    outbox row naming its address stayed for ever, and edge_bff_runtime holds no DELETE on the outbox (20261116_003:
+--    "never deleted"). The rule here follows CONTRACT 4's: an address that has no row in edge_bff.users (no account and
+--    no pending registration: never verified and purged, or never registered) keeps no sent, failed, expired or
+--    suppressed outbox row older than 24 h. The function edge_bff.purge_email_outbox() deletes exactly those, at most
+--    10 000 per call; edge_bff_runtime may execute it and still holds no DELETE on the table, so the rule is the only
+--    delete edge-bff can make. The rows of an address that has an account are kept: their retention is a decision of the
+--    user (fix_round/auth.md, decisions; the Privacy text names it), applied later by replacing this function.
+-- Forward-only; refuses a second run; rollback block at the end (comment).
+BEGIN;
+SET LOCAL lock_timeout = '5s';
+SET LOCAL statement_timeout = '1min';
+DO $preflight$
+BEGIN
+    IF to_regclass('edge_bff.email_outbox') IS NULL OR to_regclass('edge_bff.users') IS NULL THEN
+        RAISE EXCEPTION 'edge_bff.email_outbox or edge_bff.users is missing: apply 20261116_003 first';
+    END IF;
+    IF to_regclass('edge_bff.email_outbox_to_email_created') IS NOT NULL OR to_regclass('edge_bff.email_outbox_unsent') IS NOT NULL
